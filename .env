# Copy to .env and adjust. Never commit .env.

# --- compose ---
COMPOSE_PROJECT_NAME=everwas
# dev = hot reload + bind mounts + mailpit; prod = built images + caddy labels
EVERWAS_MODE=dev

# --- public hostnames (nginx reverse proxy, both modes) ---
# The app and the API share ONE origin.
EVERWAS_DOMAIN=rmm.mainstreetmint.top
# MCP clients present a bearer API key rather than the browser session, so it
# gets its own origin.
EVERWAS_MCP_DOMAIN=mcp-rmm.mainstreetmint.top
# Dev only. Defaults to mail-$EVERWAS_DOMAIN.
EVERWAS_MAIL_DOMAIN=mail-rmm.mainstreetmint.top
# Agents connect here. It MUST be its own hostname serving at the root.
EVERWAS_NATS_DOMAIN=nats-rmm.mainstreetmint.top

# --- postgres ---
POSTGRES_DB=everwas
POSTGRES_USER=everwas
POSTGRES_PASSWORD=5e5151de7724170765a5e9b6bbfff9a11020194ba26555db

# --- server ---
# secret for session cookie signing / CSRF; generate: openssl rand -hex 32
EVERWAS_SECRET_KEY=6f737d0257cdbde9dcfb0c17d5c28b0299e361d45b43f0fdac3f66ecf7470962

# --- nats auth ---
# generated with: cd server && uv run everwas gen-nats-keys
EVERWAS_NATS_AUTH_SEED=SAAKNDWMQFY7AAKUZ3BAOVJ676ZIPRBI4OW3JDS67WE2DZSE6OW5SGZGMQ
EVERWAS_NATS_AUTH_ISSUER=ADMKBOFL7RNQTSYTXUCHKVQQY5KX3ANMZ3TWTUDGMUL7RZXMVT3AXJ7J
# password for the internal `server` NATS user (api/dispatcher); openssl rand -hex 24
EVERWAS_NATS_SERVER_PASSWORD=cd183159590ffff0935a00c1b3c30b5c106421af15d9330b
# What enrolled agents are told to dial: $EVERWAS_NATS_DOMAIN, at the root.
# Baked into each agent's config AT ENROLLMENT, so changing it later does not
# move agents that are already in the field.
EVERWAS_NATS_PUBLIC_URL=wss://nats-rmm.mainstreetmint.top

# --- smtp (prod; dev uses mailpit) ---
EVERWAS_SMTP_HOST=
EVERWAS_SMTP_PORT=587
EVERWAS_SMTP_USER=
EVERWAS_SMTP_PASSWORD=
EVERWAS_SMTP_FROM=everwas@example.com

# --- mcp ---
# the MCP server is opt-in
EVERWAS_MCP_ENABLED=false

# --- posture egress (opt-in) ---
EVERWAS_POSTURE_EGRESS_SUBJECT=

# Encrypts the device CA intermediate key at rest. Generate with:
#   openssl rand -base64 36
# Back this up separately from the server: losing it orphans every device
# certificate already issued.
EVERWAS_CA_PASSPHRASE=cY0fnIyBig4Tw1hqKBzpBs5uPSDaRvJNUwjsOhxY3tADicyr

# Days an issued device certificate is valid. Default 90.
EVERWAS_CA_CERT_LIFETIME_DAYS=90